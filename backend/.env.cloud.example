# Online database used by `npm run db:copy-to-cloud`.
# Copy this file to .env.cloud (same folder) and fill in the values from your provider (e.g. Aiven > Connection information).
# .env.cloud is never uploaded to GitHub.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=defaultdb
DB_SSL=true
DB_SSL_CA=
