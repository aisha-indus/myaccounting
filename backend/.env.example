PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ibms
DB_USER=root
DB_PASSWORD=

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=2h

# Frontend origin (CORS + links inside emails)
CLIENT_URL=http://localhost:3000

# Email (leave SMTP_HOST empty to log emails to the console instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="IBMS <no-reply@example.com>"

# Password given to every sample user created by `npm run db:seed`
SEED_PASSWORD=

# Cloud MySQL (Aiven, TiDB Cloud, Railway...) needs an encrypted connection: set DB_SSL=true.
# Optional: paste the provider's CA certificate (PEM, \n for new lines) to also verify the server.
DB_SSL=false
DB_SSL_CA=
